{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pixreveal",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "Add a new PixReveal game post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Reset scores",
        "description": "Delete all stored scores",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-scores"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "pixreveal_dev"
  },
  "marketingAssets": {
    "icon": "public/assets/logo.png"
  }
}