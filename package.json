{
  "private": true,
  "name": "pixreveal",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "vue-tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.14.7",
    "@devvit/web": "0.14.7",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@hono/node-server": "2.1.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "devvit": "^0.14.8",
    "hono": "4.13.13",
    "pinia": "^4.0.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
